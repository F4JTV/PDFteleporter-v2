        '\nQWidget {{\n    background-color: {bg_dark};\n    color: {text_primary};\n    font-family: "Segoe UI", Arial, sans-serif;\n    font-size: 10pt;\n}}\nQMainWindow, QDialog {{ background-color: {bg_dark}; }}\n\nQGroupBox {{\n    background-color: {bg_medium};\n    border: 1px solid {bg_light};\n    border-radius: 6px;\n    margin-top: 16px;\n    padding: 10px;\n    font-family: Consolas, "Courier New", monospace;\n    font-size: 11pt;\n    font-weight: bold;\n}}\nQGroupBox::title {{\n    subcontrol-origin: margin;\n    subcontrol-position: top center;\n    padding: 2px 12px;\n    background-color: {bg_dark};\n    color: {accent_cyan};\n}}\nQGroupBox#panelDecompress::title {{ color: {accent_green}; }}\nQGroupBox#panelLog {{\n    font-size: 9pt;\n    font-weight: normal;\n}}\nQGroupBox#panelLog::title {{ color: {text_dim}; subcontrol-position: top left; }}\n\nQLabel {{ background: transparent; }}\nQLabel#h1 {{\n    font-family: Consolas, "Courier New", monospace;\n    font-size: 18pt; font-weight: bold; color: {accent_orange};\n}}\nQLabel#version   {{ color: {text_dim}; font-family: Consolas, monospace; }}\nQLabel#sectionTitle {{ color: {accent_orange}; font-weight: bold; }}\nQLabel#fileInfo  {{ color: {text_dim}; font-family: Consolas, monospace; font-size: 8pt; }}\nQLabel#hint      {{ color: {text_dim}; }}\nQLabel#footer    {{ color: {text_dim}; font-size: 8pt; }}\nQLabel#statusOk  {{ color: {success}; font-family: Consolas, monospace; font-size: 9pt; }}\nQLabel#statusKo  {{ color: {error};   font-family: Consolas, monospace; font-size: 9pt; }}\nQLabel#radioHint {{ color: {text_dim}; font-size: 8pt; }}\n\nQLineEdit {{\n    background-color: {bg_input};\n    color: {text_primary};\n    border: 1px solid {bg_light};\n    border-radius: 3px;\n    padding: 4px 6px;\n    font-family: Consolas, "Courier New", monospace;\n    font-size: 9pt;\n}}\nQLineEdit:read-only {{ color: {text_secondary}; }}\n\nQPushButton {{\n    background-color: {bg_light};\n    color: {text_primary};\n    border: 1px solid #2a3350;\n    border-radius: 4px;\n    padding: 5px 10px;\n}}\nQPushButton:hover  {{ background-color: #27304f; }}\nQPushButton:pressed{{ background-color: #161c30; }}\nQPushButton:disabled {{ color: {text_dim}; background-color: #12172a; border-color: #1b2138; }}\n\nQPushButton#browseBlue  {{ color: {accent_blue}; }}\nQPushButton#browseGreen {{ color: {accent_green}; }}\n\nQPushButton#primaryCyan, QPushButton#primaryGreen, QPushButton#primaryYellow {{\n    color: #000000;\n    font-family: Consolas, "Courier New", monospace;\n    font-weight: bold;\n    border: none;\n    border-radius: 5px;\n    padding: 10px;\n    font-size: 12pt;\n}}\nQPushButton#primaryCyan   {{ background-color: {accent_cyan}; }}\nQPushButton#primaryCyan:hover  {{ background-color: #62efff; }}\nQPushButton#primaryGreen  {{ background-color: {accent_green}; }}\nQPushButton#primaryGreen:hover {{ background-color: #66ffa6; }}\nQPushButton#primaryYellow {{ background-color: {accent_yellow}; font-size: 10pt; padding: 7px; }}\nQPushButton#primaryYellow:hover {{ background-color: #ffff74; }}\nQPushButton#primaryCyan:disabled, QPushButton#primaryGreen:disabled,\nQPushButton#primaryYellow:disabled {{ background-color: #263042; color: {text_dim}; }}\n\nQRadioButton {{ background: transparent; spacing: 6px; padding: 1px; }}\nQRadioButton::indicator {{ width: 13px; height: 13px; }}\nQRadioButton::indicator:unchecked {{\n    border: 2px solid {text_dim}; border-radius: 8px; background: {bg_dark};\n}}\nQRadioButton::indicator:checked {{\n    border: 2px solid {accent_cyan}; border-radius: 8px; background: {accent_cyan};\n}}\n\nQTextEdit {{\n    background-color: {bg_dark};\n    color: {text_secondary};\n    border: 1px solid {bg_light};\n    border-radius: 3px;\n    font-family: Consolas, "Courier New", monospace;\n    font-size: 9pt;\n}}\nQTextEdit#estimates {{ color: {accent_cyan}; border: 1px solid #202a45; }}\n\nQProgressBar {{\n    background-color: {bg_input};\n    border: 1px solid {bg_light};\n    border-radius: 3px;\n    text-align: center;\n    color: {text_secondary};\n    font-size: 8pt;\n    height: 14px;\n}}\nQProgressBar::chunk {{ background-color: {accent_blue}; border-radius: 2px; }}\n\nQScrollArea {{ background: transparent; border: none; }}\nQScrollArea > QWidget > QWidget {{ background: transparent; }}\n\nQScrollBar:vertical {{ background: {bg_dark}; width: 10px; margin: 0; }}\nQScrollBar::handle:vertical {{ background: {bg_light}; border-radius: 5px; min-height: 24px; }}\nQScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}\nQFrame#hline {{ background-color: {bg_light}; max-height: 1px; border: none; }}\nQFrame#accentLine {{ background-color: {accent_orange}; max-height: 2px; border: none; }}\n'
