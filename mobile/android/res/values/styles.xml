<resources>
    <!-- The window shown before the interface draws its first frame: black,
         whatever the palette, so that a night start does not flash white. -->
    <style name="PdftTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>
</resources>
